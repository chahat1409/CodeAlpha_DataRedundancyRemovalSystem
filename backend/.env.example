# ================================================================
# CloudGuard — Data Redundancy Removal System (Backend Config)
# CodeAlpha Cloud Computing Task 1
# ================================================================

# Server Port
PORT=5000

# Environment Mode (development | test | production)
NODE_ENV=development

# MongoDB Atlas Cloud Database Connection String
# Sign up at https://www.mongodb.com/cloud/atlas (Free Tier M0)
# Create a cluster -> Database Access (User/Password) -> Network Access (Allow 0.0.0.0/0)
# Copy your connection string here:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cloudguard_db?retryWrites=true&w=majority

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
